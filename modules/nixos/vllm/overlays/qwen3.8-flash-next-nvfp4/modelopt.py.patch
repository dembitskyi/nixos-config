+        # MTP draft layers are numbered from num_hidden_layers in vLLM (e.g.
+        # mtp.layers.48.*), but ModelOpt's quantized_layers keys use the
+        # draft-local index (mtp.layers.0.*). Offer the draft-local index so the
+        # FP8_BLOCK_SCALES MTP experts resolve their algo instead of loading
+        # unquantized (which fails: has no parameter 'w2_weight_scale_inv').
+        m = re.match(r"^(.*?mtp\.layers\.)(\d+)(\..*)$", prefix)
+        if m:
+            k = int(m.group(2))
+            for j in range(0, min(k, 8) + 1):
+                if j != k:
+                    candidates.append(f"{m.group(1)}{j}{m.group(3)}")
+
         return tuple(dict.fromkeys(candidates))
 
+    def _quantized_layer_group_size(self, prefix: str) -> int | None:
+        """group_size of the quantized_layers entry that covers prefix."""
+        for cand in self._quantized_layer_prefix_candidates(prefix):
+            info = self.quantized_layers.get(cand)
+            if info:
+                try:
+                    return int(info.get("group_size") or 0) or None
+                except (TypeError, ValueError):
+                    return None
+        return None
+
