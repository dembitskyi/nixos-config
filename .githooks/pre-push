#!/usr/bin/env bash
# Tracked pre-push gate (shared via core.hooksPath = .githooks).
set -euo pipefail

system=$(nix eval --raw --impure --expr 'builtins.currentSystem')
echo "pre-push: checking formatting (${system})…"
# checks.<system>.treefmt comes from the treefmt-nix flake module.
nix build --no-link ".#checks.${system}.treefmt"
