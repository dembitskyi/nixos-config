+
+test("plugins select a model and its variant for the prompt", async () => {
+  await using setup = await renderLocal({ models: [model("first", ["low"]), model("second", ["low", "high"])] })
+  const selected = pluginModel(setup.local, setup)
+
+  expect(selected.set({ providerID: "provider", modelID: "second", variant: "high" })).toBe(true)
+  expect(selected.current()).toEqual({ providerID: "provider", modelID: "second", variant: "high" })
+
+  expect(selected.set({ providerID: "provider", modelID: "first" })).toBe(true)
+  expect(selected.current()).toEqual({ providerID: "provider", modelID: "first", variant: undefined })
+})
+
+test("plugins replace a session's pending model choice", async () => {
+  await using setup = await renderLocal({
+    models: [model("first"), model("second", ["high"]), model("third")],
+    sessions: [session("ses_1", { providerID: "provider", id: "first" })],
+  })
+  await setup.data.session.sync("ses_1")
+  setup.route.navigate({ type: "session", sessionID: "ses_1" })
+  setup.local.model.set({ providerID: "provider", modelID: "third" })
+  expect(setup.local.model.current()?.modelID).toBe("third")
+
+  const selected = pluginModel(setup.local, setup)
+  expect(selected.set({ providerID: "provider", modelID: "second", variant: "high" })).toBe(true)
+  expect(selected.current()).toEqual({ providerID: "provider", modelID: "second", variant: "high" })
+})
+
+test("plugins cannot select unavailable models or variants", async () => {
+  await using setup = await renderLocal({ models: [model("first", ["low"]), model("second")] })
+  const selected = pluginModel(setup.local, setup)
+
+  expect(selected.set({ providerID: "provider", modelID: "missing" })).toBe(false)
+  expect(selected.set({ providerID: "provider", modelID: "second", variant: "low" })).toBe(false)
+  expect(selected.current()).toEqual({ providerID: "provider", modelID: "first", variant: undefined })
+})
