#!/usr/bin/env bash
set -euo pipefail

readonly OPENCODE_URL="http://127.0.0.1:4097"
readonly PASSWORD_FILE="$HOME/.local/share/opencode/sandbox-server.password"
readonly MAX_TIME=120

clip=$(wl-paste -p 2>/dev/null) || true
[[ -z ${clip:-} ]] && {
  notify-send "ClipTextRefiner" "No text selected"
  exit 1
}

OPENCODE_PASSWORD=$(cat "$PASSWORD_FILE") || {
  notify-send "ClipTextRefiner" "OpenCode server password missing"
  exit 1
}
export OPENCODE_PASSWORD

# `--format json` prints one event per line; the answer is in the text events.
improved=$(printf '%s' "$clip" |
  timeout "$MAX_TIME" opencode run --server "$OPENCODE_URL" --agent refine --title clip-text-refiner --format json |
  jq -rs 'map(select(.type == "text") | .part.text) | join("\n")') || improved=""

if [[ -n ${improved:-} ]]; then
  printf '%s' "$improved" | wl-copy
  notify-send "ClipTextRefiner" "Text improved → clipboard ready"
else
  notify-send "ClipTextRefiner" "OpenCode processing failed"
fi
