+#                                Triton-Schreiber bei head_dim 256)
+_QFN_NVFP4_WRITER = _qfn_os.environ.get("QFN_KVQ_NVFP4_WRITER", "native").strip().lower()
+_QFN_V_SF_SWIZZLED = _qfn_os.environ.get("QFN_KVQ_V_SF_SWIZZLED", "").strip()
